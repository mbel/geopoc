{
  "name": "@geoclash/sim",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "graph:build": "tsx src/scripts/buildGraph.ts",
